{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "stats/run_footprints.json",
 "type": "object",
 "required": [
  "schemaVersion",
  "asOf",
  "window",
  "universe",
  "runs",
  "bigMovePct",
  "label",
  "medians",
  "lift",
  "longHorizon"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "window": {
   "type": "object"
  },
  "label": {
   "type": "string"
  },
  "universe": {
   "type": "object",
   "required": [
    "name",
    "label",
    "stocks"
   ]
  },
  "runs": {
   "type": "object",
   "required": [
    "UP",
    "DOWN"
   ]
  },
  "bigMovePct": {
   "type": "number"
  },
  "medians": {
   "type": "object",
   "required": [
    "columns",
    "rows"
   ],
   "properties": {
    "columns": {
     "const": [
      "window",
      "dir",
      "bucket",
      "feature",
      "median",
      "n"
     ]
    },
    "rows": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
       {
        "type": "string"
       },
       {
        "type": "string"
       },
       {
        "type": "string"
       },
       {
        "type": "string"
       },
       {
        "type": [
         "number",
         "null"
        ]
       },
       {
        "type": "integer"
       }
      ]
     }
    }
   }
  },
  "lift": {
   "type": "object",
   "required": [
    "columns",
    "rows",
    "base"
   ],
   "properties": {
    "columns": {
     "const": [
      "horizon",
      "feature",
      "quintile",
      "n",
      "bigUpPct",
      "bigDownPct"
     ]
    },
    "rows": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
     }
    },
    "base": {
     "type": "object"
    }
   }
  },
  "longHorizon": {
   "type": "object",
   "required": [
    "status",
    "columns",
    "rows",
    "base"
   ],
   "properties": {
    "status": {
     "enum": [
      "computed",
      "needs more history"
     ]
    },
    "columns": {
     "const": [
      "horizon",
      "feature",
      "quintile",
      "n",
      "bigUpPct",
      "bigDownPct"
     ]
    },
    "rows": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
     }
    },
    "base": {
     "type": "object"
    }
   }
  }
 }
}
