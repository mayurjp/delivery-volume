{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "cum/{date}.json",
 "type": "object",
 "required": [
  "schemaVersion",
  "columns",
  "rows",
  "date"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "columns": {
   "const": [
    "sym",
    "lastClose",
    "lastTradeDate",
    "cDelivValCr",
    "cTurnoverCr",
    "cDelivQty",
    "cVol",
    "cDays"
   ]
  },
  "rows": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/row"
   }
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  }
 },
 "$defs": {
  "row": {
   "type": "array",
   "minItems": 8,
   "maxItems": 8,
   "prefixItems": [
    {
     "type": [
      "string",
      "null"
     ]
    },
    {
     "type": [
      "number",
      "null"
     ]
    },
    {
     "type": [
      "string",
      "null"
     ]
    },
    {
     "type": [
      "number",
      "null"
     ]
    },
    {
     "type": [
      "number",
      "null"
     ]
    },
    {
     "type": [
      "integer",
      "null"
     ]
    },
    {
     "type": [
      "integer",
      "null"
     ]
    },
    {
     "type": [
      "integer",
      "null"
     ]
    }
   ]
  }
 }
}
