{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "stats/signal_perf_periods.json",
 "type": "object",
 "required": [
  "schemaVersion",
  "asOf",
  "window",
  "timeframes",
  "groups",
  "minN",
  "events",
  "label",
  "columns",
  "rows"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "minN": {
   "type": "integer"
  },
  "window": {
   "type": "object",
   "required": [
    "from",
    "to"
   ]
  },
  "timeframes": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "horizons",
     "horizonLabels"
    ]
   }
  },
  "groups": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "events": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "label"
    ]
   }
  },
  "label": {
   "type": "string"
  },
  "columns": {
   "const": [
    "tf",
    "event",
    "group",
    "horizon",
    "events",
    "n",
    "periods",
    "medianExcess",
    "meanExcess",
    "hitRate"
   ]
  },
  "rows": {
   "type": "array",
   "items": {
    "type": "array",
    "minItems": 10,
    "maxItems": 10
   }
  }
 }
}
