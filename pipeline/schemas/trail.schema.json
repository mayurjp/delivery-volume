{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "trail/latest.json, trail/asof/{date}.json",
 "type": "object",
 "required": [
  "schemaVersion",
  "asOf",
  "stripWeeks",
  "windows",
  "windowDays",
  "windowColumns",
  "indicators",
  "slots",
  "listSize",
  "label",
  "columns",
  "rows",
  "config"
 ],
 "properties": {
  "config": {
   "type": "object"
  },
  "snapshots": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   }
  },
  "schemaVersion": {
   "const": 1
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "stripWeeks": {
   "type": "array",
   "items": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "windows": {
   "const": [
    "3M",
    "6M",
    "1Y"
   ]
  },
  "windowDays": {
   "type": "array",
   "items": {
    "type": "integer"
   }
  },
  "windowColumns": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "indicators": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "label",
     "rule"
    ]
   }
  },
  "slots": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "label",
     "arrives"
    ]
   }
  },
  "listSize": {
   "type": "integer"
  },
  "label": {
   "type": "string"
  },
  "columns": {
   "const": [
    "sym",
    "strip",
    "3M",
    "6M",
    "1Y"
   ]
  },
  "rows": {
   "type": "array",
   "items": {
    "type": "array",
    "minItems": 5,
    "maxItems": 5,
    "prefixItems": [
     {
      "type": [
       "string"
      ]
     },
     {
      "type": [
       "string"
      ]
     },
     {
      "type": [
       "array",
       "null"
      ]
     },
     {
      "type": [
       "array",
       "null"
      ]
     },
     {
      "type": [
       "array",
       "null"
      ]
     }
    ]
   }
  }
 }
}
