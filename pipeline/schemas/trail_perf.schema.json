{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "stats/trail_perf.json",
 "type": "object",
 "required": [
  "schemaVersion",
  "asOf",
  "universe",
  "windows",
  "horizons",
  "asOfDates",
  "minN",
  "listSize",
  "lists",
  "indicators",
  "label",
  "columns",
  "rows"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "asOf": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "universe": {
   "type": "string"
  },
  "windows": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "horizons": {
   "type": "array",
   "items": {
    "type": "integer"
   }
  },
  "asOfDates": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
   }
  },
  "minN": {
   "type": "integer"
  },
  "listSize": {
   "type": "integer"
  },
  "lists": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "label"
    ]
   }
  },
  "indicators": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "label"
    ]
   }
  },
  "label": {
   "type": "string"
  },
  "columns": {
   "const": [
    "kind",
    "id",
    "window",
    "horizon",
    "n",
    "dates",
    "medianExcess",
    "meanExcess",
    "hitRate"
   ]
  },
  "rows": {
   "type": "array",
   "items": {
    "type": "array",
    "minItems": 9,
    "maxItems": 9,
    "prefixItems": [
     {
      "type": "string"
     },
     {
      "type": "string"
     },
     {
      "type": "string"
     },
     {
      "type": "integer"
     },
     {
      "type": "integer"
     },
     {
      "type": "integer"
     },
     {
      "type": [
       "number",
       "null"
      ]
     },
     {
      "type": [
       "number",
       "null"
      ]
     },
     {
      "type": [
       "number",
       "null"
      ]
     }
    ]
   }
  }
 }
}
